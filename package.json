{
  "name": "jev-mcp",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "MCP stdio server exposing the TypeSafe Jev System One decision engine as typed-judgment tools.",
  "bin": {
    "jev-mcp": "./src/server.js",
    "laya-mcp": "./src/laya-server.js"
  },
  "scripts": {
    "test": "TYPESAFE_SPEND_LOG=${TMPDIR:-/tmp}/jev-mcp-test-spend.jsonl LAYA_DECISION_LOG=${TMPDIR:-/tmp}/jev-mcp-test-laya.jsonl node --test tests/*.test.js",
    "doctor": "node tools/doctor.mjs --live --after-restart",
    "doctor:before-restart": "node tools/doctor.mjs --live"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@typesafe-ai/sdk": "0.6.0"
  }
}
